# Copy this file to .env and fill in real values. .env is gitignored;
# this template (with placeholders only, no real secrets) is safe to commit.

# ThingSpeak channel (Phase 1/2 — live polling)
THINGSPEAK_CHANNEL_ID=your_channel_id_here
THINGSPEAK_READ_API_KEY=your_read_api_key_here

# Telegram bot alerts (Phase 3) — optional. Leave unset and notifier.py just
# prints what it would have sent instead of erroring.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Gemini chatbot (Phase 4) — get a free-tier key at https://aistudio.google.com/apikey
# Required for /api/chat; the app still starts fine without it (returns a
# "chatbot not configured" error until set).
GEMINI_API_KEY=your_gemini_api_key_here
